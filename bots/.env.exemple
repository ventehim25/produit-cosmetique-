# Gratuit : rien à remplir si tu es connecté à GitHub (gh auth login).
# Si GitHub refuse, crée un jeton avec la permission "Models" sur
# https://github.com/settings/personal-access-tokens/new et colle-le ici :
GITHUB_TOKEN=

# Payant (optionnel) : clé OpenAI
OPENAI_API_KEY=colle-ta-cle-ici
OPENAI_MODEL=gpt-4o-mini
